# Copy to apps/web/.env.local (Next.js reads its env files from apps/web). These values work for local development with test sign-in.
APP_URL=http://localhost:3000

# Turso when hosted (libsql://<db>-<org>.turso.io and a token); a local file in development.
# The Vercel Turso integration sets TURSO_DATABASE_URL and TURSO_AUTH_TOKEN instead; the app reads those too.
# Relative to apps/web: the same <repo>/.data/dev.db that `pnpm --filter @partner-desk/platform db:migrate` makes.
DATABASE_URL=file:../../.data/dev.db
DATABASE_AUTH_TOKEN=

# At least 32 characters. Signs sessions AND encrypts the stored Google tokens: never rotate it.
# Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# The shared PartnerStandard Google OAuth client (Web application). Set both or neither.
# Redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 1 = test sign-in (throwaway users, their files in server memory). Never on a deployment: on Vercel the app fails
# its first request with it.
PD_TEST_AUTH=1

# MAP emails (Resend). Set both or neither: without them no email goes out, Send link is hidden, and the daily job still
# refreshes each partner type's MAP health. EMAIL_FROM is a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Staging only: comma-separated addresses; every other recipient is dropped (logged with ids). Leave empty in production.
EMAIL_ALLOWLIST=
# What Vercel Cron sends to /api/cron/tick as "Authorization: Bearer …". At least 16 characters; without it the job
# answers 401. Make one with: openssl rand -base64 32
CRON_SECRET=
# Self-hosted only: the server runs the job every 15 minutes by itself, calling /api/cron/tick with CRON_SECRET (a random
# one for its own process when CRON_SECRET is empty). off stops it, for a company that calls the route itself. Under
# `next dev` it is off unless set to on: real mail keys here would send MAP emails every 15 minutes.
SCHEDULER=
# Self-hosted only: off stops the daily look at GitHub's public release list for Settings' update notice. A build that
# isn't a release (no APP_VERSION, set by the release workflow) never looks.
UPDATE_CHECK=
# Self-hosted only: 1 lets webhooks go to http addresses and to private or local networks (n8n on the same machine).
# Never set it on Vercel: the app refuses to start with it there. Off (empty or 0) by default.
WEBHOOKS_ALLOW_PRIVATE=

# Which edition: hosted (the default; the work in each person's Google Drive) or self-hosted (the work in this
# server's own database). Self-hosted never runs on Vercel.
EDITION=
# Only PartnerStandard's own hosted service sets partnerstandard here: it shows the PartnerStandard logo. Left empty, the
# app is the Community Edition, with its own plain mark (README, "The PartnerStandard name and logo"). Read when the app
# is built, not when it starts.
NEXT_PUBLIC_PD_BRAND=
# Self-hosted only: the email address of the person who signs in first and becomes the company's first admin. Others
# sign in once an admin invites them. Keep it set: without it the sign-in page says the server has no first admin yet,
# and nobody can sign in.
# A company server also needs APP_URL, its own address, which the sign-in emails link to. Test sign-in
# (PD_TEST_AUTH=1) on a company server works only with APP_URL=http://localhost:3000 or another local address.
ADMIN_EMAIL=
# Self-hosted only: how many requests a minute each agent or API key may make, 1 to 6000. Hosted keeps 60.
AGENT_REQUESTS_PER_MINUTE=

# Self-hosted only (EDITION=self-hosted): the company's own privacy policy, terms and imprint, as full web
# addresses (https://acme.example/privacy; http works too). The footer links to each one set, and to none when none
# is set; PartnerStandard's own pages never show there (/privacy, /terms and /imprint answer "not found"). The sign-in
# page names the terms and the privacy policy only when both are set. Hosted refuses them: it shows PartnerStandard's
# pages.
LEGAL_PRIVACY_URL=
LEGAL_TERMS_URL=
LEGAL_IMPRINT_URL=
