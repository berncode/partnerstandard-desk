# PartnerStandard Desk's settings on your own server. Copy to .env beside docker-compose.yml and fill it in.
# Every setting is read when the app starts: after a change, run `docker compose up -d` again.
# Never put this file in Git: it holds your secrets. Write values without quotes: `docker run --env-file` keeps them.

# ── Required ────────────────────────────────────────────────────────────────────────────────────────────────────────

# The address people open, exactly as they type it. Sign-in emails and links point here.
# With the https profile: https:// and APP_DOMAIN below. Trying it on your own computer: http://localhost:3000
APP_URL=https://desk.example.com

# Signs sign-ins and protects stored keys. At least 32 characters; make one with: openssl rand -base64 32
# Keep it: a new one signs everyone out and turns off every agent and API key.
BETTER_AUTH_SECRET=

# The email address of the person who signs in first and becomes the first admin. Others sign in once invited.
ADMIN_EMAIL=

# Sign-in links go out by email through Resend (resend.com): an API key, and a sender on a domain you verified there,
# like: PartnerStandard Desk <desk@example.com>. Set both, or neither (then nobody gets a sign-in email).
RESEND_API_KEY=
EMAIL_FROM=

# ── HTTPS (the https profile) ───────────────────────────────────────────────────────────────────────────────────────

# Caddy gets a certificate for this domain by itself. Point its DNS at this server and open ports 80 and 443.
APP_DOMAIN=desk.example.com

# Where the app itself listens on this computer. The default lets only this computer in (Caddy and you). Behind your
# own proxy on another machine, use this server's private address, like 10.0.0.5:3000, and let only the proxy in.
# Never plain 3000: Docker opens it to the whole internet, past firewalls like ufw.
# APP_PORT=127.0.0.1:3000

# ── Backups (the backup profile) ────────────────────────────────────────────────────────────────────────────────────

# Litestream copies every save to S3-type storage: Hetzner, Cloudflare R2, AWS S3, Backblaze B2, MinIO and others.
# Make a bucket and a key that may read and write it.
LITESTREAM_BUCKET=
# A folder in the bucket, if it holds other things too.
# LITESTREAM_PATH=partnerstandard-desk
# Empty for AWS; else the provider's address, like https://fsn1.your-objectstorage.com or
# https://<account id>.r2.cloudflarestorage.com
LITESTREAM_ENDPOINT=
# AWS: found by itself. Others: as the provider says (R2: auto); empty works for most.
# LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ── Optional ────────────────────────────────────────────────────────────────────────────────────────────────────────

# Every value here also reaches the app's own settings; the app reads only its own and ignores the rest.

# Which image: this repository's on GitHub. One you built yourself: partnerstandard-desk, with the version local.
# DESK_IMAGE=ghcr.io/berncode/partnerstandard-desk

# Which version runs: latest, or a fixed one like 1.4 (stays on the 1.4 line) or 1.4.2 (exactly that one).
# DESK_VERSION=latest

# The job that sends reminders, digests and webhooks runs every 15 minutes inside the app. Set to off only if you
# call /api/cron/tick from your own scheduler, with "Authorization: Bearer <CRON_SECRET>". CRON_SECRET: 16 characters
# or more; make one with: openssl rand -base64 32
# on or off.
# SCHEDULER=on
# CRON_SECRET=

# At most once a day, when an admin opens Settings, the app asks GitHub for the newest release and shows when one is
# out. It sends nothing else. off also hides the version line in Settings.
# on or off.
# UPDATE_CHECK=on

# How many requests a minute each agent or API key may make, 1 to 6000.
# AGENT_REQUESTS_PER_MINUTE=60

# 1 lets webhooks go to http addresses and to your own network (n8n on the same server, for example).
# WEBHOOKS_ALLOW_PRIVATE=0

# Your company's own privacy policy, terms and imprint, as full addresses. The footer links to each one set.
# LEGAL_PRIVACY_URL=
# LEGAL_TERMS_URL=
# LEGAL_IMPRINT_URL=
